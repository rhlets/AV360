-wrap:wrap\">\n              <x-import component-from-global-scope=\"DesignSystem_9154eb.Button\" variant=\"primary\" disabled=\"{{ sending }}\" sc-camel-on-click=\"{{ onPresenca }}\" hint-size=\"140px,44px\">Registrar<\u002Fx-import>\n              <x-import component-from-global-scope=\"DesignSystem_9154eb.Button\" variant=\"ghost\" sc-camel-on-click=\"{{ goEntrada }}\" hint-size=\"120px,44px\">Pular<\u002Fx-import>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fform>\n      <\u002Fsc-if>\n\n      <sc-if value=\"{{ isPresencaOk }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"display:flex;flex-direction:column;gap:24px\">\n          <x-import component-from-global-scope=\"DesignSystem_9154eb.ParallelLines\" size=\"sm\" tone=\"solaris\" width=\"{{ 84 }}\" hint-size=\"84px,14px\"><\u002Fx-import>\n          <h1 style=\"margin:0;font-size:clamp(28px,3.4vw,40px);letter-spacing:-.02em;line-height:1.1;font-weight:700\">Participação registrada.<\u002Fh1>\n          <p style=\"margin:0;font-size:16px;line-height:1.55;color:rgba(29,36,54,.72)\">Obrigado por contribuir com a avaliação. Você já pode fechar esta página.<\u002Fp>\n          <div style=\"display:flex\">\n            <x-import component-from-global-scope=\"DesignSystem_9154eb.Button\" variant=\"secondary\" sc-camel-on-click=\"{{ goEntrada }}\" hint-size=\"180px,44px\">Avaliar outra pessoa<\u002Fx-import>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsc-if>\n\n      <sc-if value=\"{{ isJaEnviada }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"display:flex;flex-direction:column;gap:24px\">\n          <x-import component-from-global-scope=\"DesignSystem_9154eb.ParallelLines\" size=\"sm\" tone=\"solaris\" width=\"{{ 84 }}\" hint-size=\"84px,14px\"><\u002Fx-import>\n          <h1 style=\"margin:0;font-size:clamp(28px,3.4vw,40px);letter-spacing:-.02em;line-height:1.1;font-weight:700\">Sua autoavaliação já foi enviada.<\u002Fh1>\n          <p style=\"margin:0;font-size:16px;line-height:1.55;color:rgba(29,36,54,.72)\">A chave individual aceita um único envio. O RH vai entregar o seu relatório na devolutiva.<\u002Fp>\n          <div style=\"display:flex\">\n            <x-import component-from-global-scope=\"DesignSystem_9154eb.Button\" variant=\"secondary\" sc-camel-on-click=\"{{ goEntrada }}\" hint-size=\"160px,44px\">Voltar ao início<\u002Fx-import>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsc-if>\n\n      <sc-if value=\"{{ isPrivacidade }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"display:flex;flex-direction:column;gap:28px\">\n          <x-import component-from-global-scope=\"DesignSystem_9154eb.ParallelLines\" size=\"sm\" tone=\"solaris\" width=\"{{ 84 }}\" hint-size=\"84px,14px\"><\u002Fx-import>\n          <div style=\"display:flex;flex-direction:column;gap:10px\">\n            <div style=\"font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#ff5c35\">Privacidade<\u002Fdiv>\n            <h1 style=\"margin:0;font-size:clamp(28px,3.4vw,40px);letter-spacing:-.02em;line-height:1.1;font-weight:700\">Como o anonimato funciona<\u002Fh1>\n          <\u002Fdiv>\n          <div style=\"display:flex;flex-direction:column;gap:0;background:#fff;border:1px solid #dcdbe0;border-radius:16px;overflow:hidden\">\n            <sc-for list=\"{{ privacidade }}\" as=\"p\" hint-placeholder-count=\"8\">\n              <div style=\"padding:18px 24px;border-bottom:1px solid #eceaee;display:flex;flex-direction:column;gap:4px\">\n                <div style=\"font-size:15px;font-weight:600\">{{ p.t }}<\u002Fdiv>\n                <div style=\"font-size:14px;line-height:1.55;color:rgba(29,36,54,.72);text-wrap:pretty\">{{ p.d }}<\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n          <div style=\"display:flex\">\n            <x-import component-from-global-scope=\"DesignSystem_9154eb.Button\" variant=\"secondary\" sc-camel-on-click=\"{{ goBackFromPriv }}\" hint-size=\"120px,44px\">Voltar<\u002Fx-import>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsc-if>\n    <\u002Fmain>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ showHeader }}\" hint-placeholder-val=\"{{ false }}\">\n    <footer style=\"border-top:1px solid #dcdbe0;background:#fff\">\n      <div style=\"max-width:1200px;margin:0 auto;padding:16px clamp(20px,5vw,64px);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:12px;color:rgba(29,36,54,.52)\">\n        <span>Informação confidencial.<\u002Fspan>\n        <span>LET'S · Avaliação 360 AI Native<\u002Fspan>\n      <\u002Fdiv>\n    <\u002Ffooter>\n  <\u002Fsc-if>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;mostrarChavesTeste&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Protótipo&quot;},&quot;exemploSempreVisivel&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:false,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Questionário&quot;}}\">\nconst BLOCKS = {\n  A: { kicker: 'Bloco A', title: 'Entrega e jeito AI Native de trabalhar',\n    desc: 'Mede o resultado que a pessoa gera e como ela usa IA para trabalhar melhor. Em cada linha, dê uma nota de 1 a 5 (ou NA). O exemplo observado é opcional, mas torna o feedback muito mais útil.',\n    comps: [\n      { title: 'A1. Resultado e impacto', items: [\n        ['A1.1', 'Entrega o que combinou, com qualidade e no prazo.', 'Entrego o que combinei, com qualidade e no prazo.'],\n        ['A1.2', 'Prioriza o que mais move o resultado do negócio e sabe dizer não ao que não importa.', 'Priorizo o que mais move o resultado do negócio e sei dizer não ao que não importa.'],\n        ['A1.3', 'Assume a responsabilidade pelo resultado, inclusive quando algo dá errado.', 'Assumo a responsabilidade pelo resultado, inclusive quando algo dá errado.']]},\n      { title: 'A2. Fluência em IA', items: [\n        ['A2.1', 'Usa IA de forma recorrente no dia a dia para ganhar qualidade ou velocidade.', 'Uso IA de forma recorrente no dia a dia para ganhar qualidade ou velocidade.'],\n        ['A2.2', 'Sabe pedir bem à IA: dá contexto, objetivo e critérios, e refina o resultado até ficar bom.', 'Sei pedir bem à IA: dou contexto, objetivo e critérios, e refino o resultado até ficar bom.'],\n        ['A2.3', 'Automatiza tarefas repetitivas em vez de refazê-las à mão.', 'Automatizo tarefas repetitivas em vez de refazê-las à mão.'],\n        ['A2.4', 'Escolhe a ferramenta de IA adequada para cada tipo de tarefa.', 'Escolho a ferramenta de IA adequada para cada tipo de tarefa.']]},\n      { title: 'A3. Julgamento e redesenho do trabalho', items: [\n        ['A3.1', 'Revisa criticamente o que a IA produz antes de usar (fatos, tom, riscos).', 'Reviso criticamente o que a IA produz antes de usar (fatos, tom, riscos).'],\n        ['A3.2', 'Protege dados sensíveis e segue as regras da empresa no uso de IA.', 'Protejo dados sensíveis e sigo as regras da empresa no uso de IA.'],\n        ['A3.3', 'Propõe novas formas de fazer o trabalho, em vez de apenas acelerar as atuais.', 'Proponho novas formas de fazer o trabalho, em vez de apenas acelerar as atuais.']]}\n    ]},\n  B: { kicker: 'Bloco B', title: 'Cultura e relações',\n    desc: 'Mede como a pessoa convive e como o jeito dela afeta o ambiente. Pares e liderados são as fontes mais fortes aqui.',\n    comps: [\n      { title: 'B1. Colaboração', items: [\n        ['B1.1', 'Compartilha informação e contexto sem que eu precise pedir.', 'Compartilho informação e contexto sem que precisem me pedir.'],\n        ['B1.2', 'Trabalha bem com outras áreas e divide o crédito pelos resultados.', 'Trabalho bem com outras áreas e divido o crédito pelos resultados.']]},\n      { title: 'B2. Confiança e respeito', items: [\n        ['B2.1', 'Cumpre os combinados e avisa com antecedência quando não consegue